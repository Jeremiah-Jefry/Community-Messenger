# Copy this file to .env and replace the placeholder values.
# .env is gitignored; never commit real secrets.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# Local dev database. Use a PostgreSQL URL in deployed environments, e.g.
#   postgresql+psycopg://user:password@localhost:5432/messenger
SQLALCHEMY_DATABASE_URL=sqlite:///./messenger.db

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60